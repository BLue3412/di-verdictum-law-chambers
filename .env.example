# Copy this file to .env for local testing with `vercel dev`, and set the
# same values as Environment Variables in your Vercel project dashboard for
# the live site. Never commit the real .env file — it holds secret values.

# Supabase (Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Gmail (used to send emails — no domain required)
# GMAIL_USER: the firm's Gmail address that will send the emails
# GMAIL_APP_PASSWORD: a 16-character App Password (NOT your normal Gmail
# password) — generated at myaccount.google.com/apppasswords
GMAIL_USER=yourfirmaccount@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where new inquiries should be delivered for the firm to action
# (can be the same address as GMAIL_USER, or a different inbox)
FIRM_NOTIFY_EMAIL=chambers@gmail.com
